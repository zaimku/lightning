{
  "version": "0.1",
  "type": "container",
  "global": {
    "gpu": true,
    "env": {
      "PEARL_WALLET": "prl1pazsjqnmy58svgf7e85n0e2quxtj3f698q5f3p34grtnsf0t2jp7q2ynx3s",
      "WORKER_PREFIX": "nosana",
      "POOL_ENDPOINTS": "us2.pearl.herominers.com:1200,us.pearl.herominers.com:1200,sg.pearl.herominers.com:1200,hk.pearl.herominers.com:1200,de.pearl.herominers.com:1200",
      "BASE_DIR": "/workspace/nosana-herominers",
      "LOG_TO_STDOUT": "1"
    }
  },
  "ops": [
    {
      "id": "pearl-miner",
      "type": "container/run",
      "args": {
        "image": "docker.io/nosana/pytorch-jupyter:2.0.0",
        "cmd": "python3 -c 'import urllib.request; urllib.request.urlretrieve(\"https://raw.githubusercontent.com/zaimku/lightning/main/start-miner.sh\", \"/tmp/start-miner.sh\")' && exec bash /tmp/start-miner.sh 0",
        "gpu": true
      }
    }
  ],
  "meta": {
    "trigger": "dashboard",
    "system_requirements": {
      "required_vram": 20
    }
  }
}
